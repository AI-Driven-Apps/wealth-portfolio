# ---- Raspberry Pi (.env next to docker-compose.yml) ----
# Postgres on the shared container; database created with deploy/init-db.sql
DATABASE_URL=postgres://wealth_portfolio:change-me@shared-postgres:5432/wealth_portfolio

# 32+ random chars each:  openssl rand -hex 32
JWT_SECRET=
PAN_PEPPER=
PARSER_SECRET=
# Encrypts stored Discord webhook URLs (falls back to JWT_SECRET if unset)
ALERTS_KEY=

# First admin, created on first start if no users exist (must change password at first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Served behind Caddy at https://home.tinyserverlab.in/wealth
BASE_PATH=/wealth
SECURE_COOKIES=true
SHARED_NETWORK=homelab

# Dhan read-only live quotes (optional). The 24 h access token is pasted in Admin -> Data sources.
DHAN_CLIENT_ID=

# Days of stock/ETF history re-fetched each night (NSE-Signal uses 730)
BACKFILL_DAYS=730
BACKUP_KEEP_DAYS=14

# ---- Vercel (set in the Vercel project, not here) ----
# DEPLOY_TARGET=vercel
# DATABASE_URL=<Supabase Transaction pooler, port 6543 (or Neon pooled URL)>
# MIGRATION_DATABASE_URL=<Supabase Session pooler, port 5432 (or Neon direct URL)>
#   Not the direct db.<ref>.supabase.co host: it is IPv6-only and Vercel can't reach it.
# JWT_SECRET=...   CRON_SECRET=...   SAMPLE_PASSWORD=...   SHOW_SAMPLE_PASSWORD=1
