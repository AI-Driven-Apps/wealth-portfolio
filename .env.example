# ---- Raspberry Pi (.env next to docker-compose.yml) ----
# Postgres on the shared container; database created with deploy/init-db.sql
DATABASE_URL=postgres://wealth_portfolio:change-me@shared-postgres:5432/wealth_portfolio

# 32+ random chars each:  openssl rand -hex 32
JWT_SECRET=
PAN_PEPPER=
PARSER_SECRET=
# Encrypts stored Discord webhook URLs (falls back to JWT_SECRET if unset)
ALERTS_KEY=

# First admin, created on first start if no users exist (must change password at first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Served behind Caddy at https://home.tinyserverlab.in/wealth
BASE_PATH=/wealth
SECURE_COOKIES=true
# Docker networks of the Pi's shared containers (`docker network ls`)
SHARED_DB_NETWORK=shared-db     # shared-postgres
SHARED_WEB_NETWORK=shared-web   # Caddy

# AI market brief (phase 7, Pi only, optional). Uses the Claude API: holdings (names,
# amounts, returns) are sent to Anthropic for each brief; folio/account numbers are not.
# Then switch the "AI market brief" module on for users in Admin -> Features.
AI_AGENTS_ENABLED=0
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5     # default
# AI_EFFORT=medium             # low | medium | high | xhigh | max
# AI_WEB_SEARCH=1              # news on the largest holdings (up to 5 searches a brief)
# AI_DAILY_LIMIT=3             # manual "write now" runs per user per day

# Dhan read-only live quotes (optional). The 24 h access token is pasted in Admin -> Data sources.
DHAN_CLIENT_ID=

# Days of stock/ETF history re-fetched each night (NSE-Signal uses 730)
BACKFILL_DAYS=730
BACKUP_KEEP_DAYS=14

# ---- Vercel (set in the Vercel project, not here; see README) ----
# Both environments: DEPLOY_TARGET=vercel  JWT_SECRET  CRON_SECRET
# Production: DATA_MODE=live, its own DATABASE_URL / MIGRATION_DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD,
#             PAN_PEPPER, ALERTS_KEY; optional PARSER_URL (https) + PARSER_SECRET for PDF imports;
#             REMOVE_SAMPLE_DATA=1 for one deploy to clear an old demo.
# Preview:    DATA_MODE=sample, a separate DATABASE_URL / MIGRATION_DATABASE_URL, SAMPLE_PASSWORD, SHOW_SAMPLE_PASSWORD=1
# DEPLOY_TARGET=vercel
# DATABASE_URL=<Supabase Transaction pooler, port 6543 (or Neon pooled URL)>
# MIGRATION_DATABASE_URL=<Supabase Session pooler, port 5432 (or Neon direct URL)>
#   Not the direct db.<ref>.supabase.co host: it is IPv6-only and Vercel can't reach it.
# JWT_SECRET=...   CRON_SECRET=...
